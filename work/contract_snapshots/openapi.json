{
  "info": {
    "title": "SekaiSync Local API",
    "version": "0.4.0-alpha"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/activity": {
      "get": {
        "operationId": "activity",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "regions",
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shorthand resolved to a numbered activity (wl or box) or kind=unresolved"
          }
        }
      }
    },
    "/api/v1/data_gaps": {
      "get": {
        "operationId": "dataGaps",
        "responses": {
          "200": {
            "description": "Known data source limitations visible to agents"
          }
        }
      }
    },
    "/api/v1/event_alias": {
      "get": {
        "operationId": "eventAlias",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "regions",
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Community event shorthand resolved to box event"
          },
          "404": {
            "description": "No matching alias or ordinal"
          }
        }
      }
    },
    "/api/v1/events/archive": {
      "get": {
        "operationId": "eventArchive",
        "parameters": [
          {
            "in": "query",
            "name": "regions",
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archived event classifications by region"
          }
        }
      }
    },
    "/api/v1/events/check": {
      "post": {
        "operationId": "eventCheck",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "regions": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 32,
                    "type": "array"
                  },
                  "timeout": {
                    "maximum": 600,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [],
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "New-event detection, base-data sync and classification"
          }
        }
      }
    },
    "/api/v1/fact_pack": {
      "get": {
        "operationId": "factPack",
        "parameters": [
          {
            "in": "query",
            "name": "entity_id",
            "required": true,
            "schema": {
              "maxLength": 256,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "default": "en",
              "maxLength": 32,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compact fact pack"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/freshness": {
      "get": {
        "operationId": "freshness",
        "responses": {
          "200": {
            "description": "Data freshness"
          }
        }
      }
    },
    "/api/v1/integrity": {
      "get": {
        "operationId": "integrity",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dedup and fidelity integrity report"
          }
        }
      }
    },
    "/api/v1/lookup": {
      "get": {
        "operationId": "lookup",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "region",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 8,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entity matches"
          }
        }
      }
    },
    "/api/v1/news": {
      "get": {
        "operationId": "news",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "body",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synced official news and announcements"
          }
        }
      }
    },
    "/api/v1/progress": {
      "get": {
        "operationId": "progress",
        "parameters": [
          {
            "description": "Region codes; comma-separated for HTTP",
            "in": "query",
            "name": "regions",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "live",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Per-region completeness percentages"
          }
        }
      }
    },
    "/api/v1/query": {
      "get": {
        "operationId": "query",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "region",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 8,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "include_overlay",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unified metadata and web text matches"
          }
        }
      }
    },
    "/api/v1/refresh": {
      "post": {
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {},
                "required": [],
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Reload cached indexes from disk"
          }
        }
      }
    },
    "/api/v1/resolve": {
      "get": {
        "operationId": "resolve",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "target_language",
            "schema": {
              "default": "zh_tw",
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source_language",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Official localized name matches"
          }
        }
      }
    },
    "/api/v1/sites": {
      "get": {
        "operationId": "sites",
        "responses": {
          "200": {
            "description": "Configured site profile from settings.json"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Store, master, web and freshness status"
          }
        }
      }
    },
    "/api/v1/tag_clouds": {
      "get": {
        "operationId": "tagClouds",
        "responses": {
          "200": {
            "description": "Tag clouds split by released(multi-lang) vs unreleased(ja-only)"
          }
        }
      }
    },
    "/api/v1/term_lookup": {
      "get": {
        "operationId": "termLookup",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "languages",
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 8,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "default": "score",
              "enum": [
                "score",
                "weight"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Extracted terms and their cross-language names"
          }
        }
      }
    },
    "/api/v1/term_penetrate": {
      "get": {
        "operationId": "termPenetrate",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "story_key",
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "languages",
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cross-language per-line penetration for a term at a story position"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/trust": {
      "get": {
        "operationId": "trust",
        "responses": {
          "200": {
            "description": "A/B/C/D trust distribution"
          }
        }
      }
    },
    "/api/v1/verify_claims": {
      "post": {
        "operationId": "verifyClaims",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "claims": {
                    "items": {
                      "properties": {
                        "claim": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "claim"
                      ],
                      "type": "object"
                    },
                    "maxItems": 100,
                    "type": "array"
                  }
                },
                "required": [
                  "claims"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Verification results"
          }
        }
      }
    },
    "/api/v1/web_browse": {
      "get": {
        "operationId": "webBrowse",
        "parameters": [
          {
            "in": "query",
            "name": "source",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "include_text",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Crawled web text filtered by source/category"
          }
        }
      }
    },
    "/api/v1/web_lookup": {
      "get": {
        "operationId": "webLookup",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 8,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "include_text",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "include_overlay",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "max_text_chars",
            "schema": {
              "default": 0,
              "maximum": 200000,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Crawled web text matches"
          }
        }
      }
    },
    "/api/v1/worldlink": {
      "get": {
        "operationId": "worldlink",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "regions",
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "World Link shorthand resolved to world_bloom event"
          },
          "404": {
            "description": "No matching World Link alias or ordinal"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ]
}